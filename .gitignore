# macOS
.DS_Store
.AppleDouble

# Jupyter
.ipynb_checkpoints/
*.pyc
__pycache__/

# R
.Rhistory
.Rproj.user/

# Docling native JSONs (2-2.5 MB cada uno, regenerables)
output/docling/*_docling.json

# Entornos locales
.env
*.log
.claude/
document_test
.venv_*

# Políticas corporativas (documentos confidenciales - NO subir)
output/rag_index/*.md
output/rag_index/*.faiss
output/rag_index/chunks_metadata.json
output/markitdown/*POL*.md
output/docling/*POL*.md

# Planes de trabajo internos: citan al cliente, rutas de documentos internos y
# hallazgos de auditoría. Se versionan aparte, no en el repo público.
PLAN_*.md
Informe_*.docx

# Artefactos generados por el pipeline (regenerables, no commitar)
output/comparador/
output/**/*.xlsx
output/**/*.pdf

# PDFs subidos desde la app Streamlit y logs de ejecución con estampa de tiempo
output/uploads/
output/logs/
