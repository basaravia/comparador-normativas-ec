# ==============================================================================
# Comparador de Normativas vs Manuales - Variables de Entorno
# Copia este archivo a .env o configúralas en Databricks Apps > Environment Variables
# ==============================================================================

# --- Vertex AI / Google Cloud Platform (Opcional para análisis con LLM) ---
# Vertex desactivado por costos — usar OpenRouter o Groq en su lugar (ver más abajo).
VERTEX_PROJECT_ID=tu-proyecto-gcp
VERTEX_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/credenciales.json

# --- OpenRouter / Groq (LLM — alternativas gratuitas a Vertex) ---
# OpenRouter: clave gratuita, sin tarjeta, en https://openrouter.ai (Settings > Keys).
OPENROUTER_API_KEY=tu-api-key-de-openrouter
# Groq: clave gratuita en https://console.groq.com (API Keys). Es Groq (groq.com,
# hardware de inferencia rápida), NO Grok/xAI.
GROQ_API_KEY=tu-api-key-de-groq

# --- Autenticación y Seguridad (Para acceso web y API) ---
AUTH_ENABLED=true
AUTH_USERNAME=tu_usuario
AUTH_PASSWORD=tu_contraseña_segura
SESSION_SECRET_KEY=clave_secreta_hex_o_alfanumerica_minimo_32_caracteres

# --- Databricks Apps Runtime (Configurado automáticamente por Databricks) ---
# DATABRICKS_APP_PORT=8501
# STREAMLIT_GATHER_USAGE_STATS=false
# PYTHONUNBUFFERED=1
