# Plantilla de configuración por entorno. Copiar a `.env` y rellenar.
#
#   cp .env.example .env
#
# `.env` está en .gitignore y NO debe versionarse nunca. Este archivo sí se versiona,
# pero SIN VALORES: es documentación de qué variables existen, no dónde guardarlas.
#
# Precedencia (ver src/settings.py):
#   UI (sidebar)  >  variable de entorno  >  .env  >  defaults de src/config.py
#
# Todo lo que se lea de aquí pasa por redact() antes de llegar a un log, al panel de
# ejecución o a la hoja de trazabilidad del papel de trabajo.

# ── Identidad de la entidad ───────────────────────────────────────────────────
# Sin esto la app arranca con un título genérico. Es deliberado: un clon limpio del
# repositorio no debe identificar al cliente.
ORG_DISPLAY_NAME=

# ── Modelos: LLM, embeddings y reranker, cada uno por separado ────────────────
#
# Los tres hablan la API de OpenAI, así que el MISMO cliente sirve para un backend
# local sin autenticación y para un endpoint remoto con token: solo cambian la URL y
# la credencial. Por eso son parámetros y no están escritos en el código.
#
# NADA de esto puede hornearse en la imagen del contenedor: en Fase 2 la URL del
# backend cambia según dónde viva (ver PLAN_MEJORAS_ANEXO.md §9).

LLM_BASE_URL=http://localhost:12434/engines/v1
LLM_API_KEY=
DMR_LLM_MODEL=

EMBED_BASE_URL=http://localhost:12434/engines/v1
EMBED_API_KEY=
EMBED_MODEL=

# Reranker. Vacío = CrossEncoder local en proceso (default).
# Con URL = endpoint remoto, y el contenedor deja de necesitar torch.
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=

# Alias histórico de LLM_BASE_URL; lo nombran config.py y la UI.
DMR_BASE_URL=http://localhost:12434/engines/v1
DMR_EMBED_MODEL=

# ── Marca ─────────────────────────────────────────────────────────────────────
# Rutas a los logotipos reales. Los archivos viven en assets/brand/, fuera de git;
# sin ellos la app cae a los placeholders versionados de assets/brand/_placeholder/.
BRAND_LOGO_BANNER=
BRAND_LOGO_MARK=
BRAND_LOGO_MEMBRETE=

# ── Fase 3 · Azure ────────────────────────────────────────────────────────────
# Todavía NO implementado (ver PLAN_MEJORAS_ANEXO.md §10). Se documenta aquí para que
# la forma de la configuración esté decidida antes de que haga falta.
#
# En producción la autenticación será por Managed Identity (DefaultAzureCredential),
# no por clave: no habrá ninguna credencial que filtrar. Estas variables son para
# desarrollo local contra un recurso de Azure.
#
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT_LLM=
# AZURE_OPENAI_DEPLOYMENT_EMBED=
# AZURE_OPENAI_API_VERSION=
