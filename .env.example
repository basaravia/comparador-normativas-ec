# Plantilla de configuración por entorno. Copiar a `.env` y rellenar.
#
#   cp .env.example .env
#
# `.env` está en .gitignore y NO debe versionarse nunca. Este archivo sí se versiona,
# pero SIN CLAVES: es documentación de qué variables existen, no dónde guardarlas.
# Las URLs y los nombres de modelo de ejemplo sí llevan valor, y dicen si están verificados.
#
# Precedencia (ver src/settings.py):
#   UI (sidebar)  >  variable de entorno  >  .env  >  defaults de src/config.py
#
# Todo lo que se lea de aquí pasa por redact() antes de llegar a un log, al panel de
# ejecución o a la hoja de trazabilidad del papel de trabajo.
#
# Al desplegar en Databricks Apps estas mismas variables se configuran en
# Apps > Environment Variables (ver app.yaml); no hay un archivo aparte.

# ── Identidad de la entidad ───────────────────────────────────────────────────
# Sin esto la app arranca con un título genérico. Es deliberado: un clon limpio del
# repositorio no debe identificar al cliente.
ORG_DISPLAY_NAME=

# ── Embeddings ────────────────────────────────────────────────────────────────
# API de OpenAI: el mismo cliente sirve para un backend local sin autenticación y para
# un endpoint remoto con token; solo cambian la URL y la credencial.
#
# Local con Ollama — VERIFICADO el 2026-09-21 en una Raspberry Pi 5 (8 GB, CPU),
# Ollama 0.34.2: `ollama pull bge-m3` → 1024 dimensiones, ~0,24 s por frase, entiende
# español y no usa prefijos. El default del proyecto sigue siendo qwen3-embedding:0.6b.
# Con Foundry no se usan estas tres: ver FOUNDRY_AI_* más abajo y MODEL_PROFILE=foundry
# (text-embedding-3-large son 3072 dimensiones; SIN verificar contra un recurso real).
#
# Cambiar de modelo obliga a reindexar (borrar output/rag_index/): no se pueden mezclar
# vectores de modelos distintos. Y a recalibrar MIN_SEMANTIC_SCORE (src/config.py): la
# escala de similitud depende del modelo.
EMBED_BASE_URL=http://localhost:11434/v1
EMBED_API_KEY=
EMBED_MODEL=bge-m3

# ── LLM local / genérico (Provider.DMR) ───────────────────────────────────────
# `DMR_BASE_URL` es la URL del backend OpenAI-compatible local (Ollama). Un endpoint
# REMOTO exige modelo explícito: sin él se falla con un error claro en vez de mandarle
# el nombre del modelo de Vertex.
DMR_BASE_URL=http://localhost:11434/v1
# Modelo del LLM local (perfil `local`). Sin default útil: el histórico es el de Vertex.
# Ejemplo verificado en esta Pi: `ollama list` → qwen2.5:3b
DMR_LLM_MODEL=
# Clave de un endpoint remoto genérico.
LLM_API_KEY=

# Reranker. Vacío = CrossEncoder local en proceso (default).
# Con URL = endpoint remoto, y el contenedor deja de necesitar torch.
RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=

# ── Groq / OpenRouter (LLM — alternativas gratuitas; Vertex desactivado por costos) ──
# El modelo también se elige en vivo en el sidebar de Streamlit (dropdown poblado desde el
# endpoint /models de cada proveedor). Sin modelo explícito, la API lo toma de estas
# variables.
#
# Groq: clave gratuita en https://console.groq.com (API Keys). Es Groq (groq.com,
# hardware de inferencia rápida), NO Grok/xAI — servicios distintos, claves distintas.
# VERIFICADO el 2026-09-21: openai/gpt-oss-120b responde. qwen/qwen3.6-27b fue retirado
# (404) y qwen/qwen3.8-27b tiene un límite de 1000 tokens de salida/min, insuficiente
# para salida estructurada. El catálogo de Groq cambia: tratar como ilustrativo.
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-120b
#
# OpenRouter: clave gratuita, sin tarjeta de crédito, en https://openrouter.ai
# (Settings → Keys). Con Groq como principal y estas dos definidas, OpenRouter actúa de
# respaldo automático si Groq falla a mitad de una corrida. Modelo de ejemplo verificado
# el 2026-09-08; el catálogo `:free` rota, tratar como ilustrativo:
OPENROUTER_API_KEY=
OPENROUTER_LLM_MODEL=liquid/lfm-2.5-2.6b:free

# ── Azure AI Foundry, cuenta propia (backend "foundry") ───────────────────────
# Solo hay que SUSTITUIR estos valores. Va por `ChatOpenAI` (LLM) y `OpenAIEmbeddings`
# (embeddings) de LangChain, con la ruta por deployment y la api-version de Azure. Los datos no salen a un tercero.
# Para usarlo, `MODEL_PROFILE=foundry` (ver "perfiles" más abajo).
#
#   FOUNDRY_AI_ENDPOINT     URL del recurso: https://<recurso>.openai.azure.com (si pegas una ruta, se ignora)
#   FOUNDRY_AI_TOKEN        clave API del recurso (cabecera `api-key`; no un token de Entra ID)
#   FOUNDRY_AI_API_VERSION  p. ej. 2024-10-21 (la que tengas habilitada en el recurso)
#   FOUNDRY_AI_DEPLOYMENT   nombre del DEPLOYMENT del LLM (no el nombre del modelo)
#   FOUNDRY_AI_EMBED_DEPLOYMENT  nombre del DEPLOYMENT de embeddings (p. ej. text-embedding-3-large)
#
# Si falta alguna, el error dice cuál. La clave nunca se escribe en el repo ni en app.yaml:
# en Databricks va como secreto.
FOUNDRY_AI_ENDPOINT=
FOUNDRY_AI_TOKEN=
FOUNDRY_AI_API_VERSION=
FOUNDRY_AI_DEPLOYMENT=
FOUNDRY_AI_EMBED_DEPLOYMENT=
#
# ── Desde un secret scope de Databricks (en vez de escribir el valor aquí) ──
# Para notebooks, jobs u otros entornos. En una Databricks APP lo recomendado es otra cosa:
# recurso secreto + `valueFrom` en app.yaml (ver docs/DEPLOY-DATABRICKS.md).
# Deja la variable vacía y di DÓNDE está con dos variables (solo nombres, nunca valores):
#   DATABRICKS_SECRET_SCOPE_<NOMBRE>   el scope
#   DATABRICKS_SECRET_KEY_<NOMBRE>     la key
# <NOMBRE> es el de la variable o su forma corta sin _AI (FOUNDRY_AI_TOKEN → FOUNDRY_TOKEN).
# DATABRICKS_SECRET_SCOPE (sin sufijo) sirve de scope común si no pones el específico.
# Se lee con dbutils.secrets.get en notebooks/jobs y con databricks-sdk en Databricks Apps
# (el service principal de la app necesita permiso READ sobre el scope).
# DATABRICKS_SECRET_SCOPE_FOUNDRY_TOKEN=
# DATABRICKS_SECRET_KEY_FOUNDRY_TOKEN=
#
# Opcional: omite el parámetro `temperature` si el modelo solo acepta la de fábrica
# (p. ej. modelos de razonamiento). Actívalo solo si el endpoint real lo rechaza.
# FOUNDRY_OMIT_TEMPERATURE=true

# ── Qué backend usa la app: perfiles ──────────────────────────────────────────
# Un solo parámetro elige el backend del LLM y de los embeddings. Los perfiles se definen en
# backend/config/perfiles.yaml (sin secretos; ahí también se agregan o editan):
#
#   default        Vertex (LLM) + embeddings locales (Ollama)        ← si no pones nada
#   foundry        Azure AI Foundry para LLM y embeddings
#   local          Ollama para LLM y embeddings (exige DMR_LLM_MODEL)
#   local_groq     Groq (LLM) + embeddings locales (Ollama)
#   personalizado  el que tú edites en el YAML
#
# El reranker no se elige: siempre es local (Qwen3-Reranker, multilingüe) con cualquier perfil.
# El perfil solo elige QUÉ backend; las credenciales y modelos siguen en las variables de
# arriba, así que puedes dejarlas todas rellenas y cambiar de proveedor con esta línea.
# Vacío = el `activo` de perfiles.yaml.
MODEL_PROFILE=
#
# Opcional, para forzar UN eje sin tocar el YAML (gana al perfil):
#   LLM_BACKEND    vertex | openrouter | groq | foundry | local
#   EMBED_BACKEND  ollama | local | vertex | foundry
# Cambiar los embeddings obliga a reindexar (borrar output/rag_index/): no se mezclan vectores
# de modelos distintos.
LLM_BACKEND=
EMBED_BACKEND=

# ── Vertex AI / Google Cloud (opcional) ───────────────────────────────────────
# Desactivado por costos; hoy devuelve 403 BILLING_DISABLED hasta reactivar la facturación
# del proyecto. La autenticación es por ADC (Application Default Credentials).
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
# Comentada a propósito: google-auth trata una variable vacía como una ruta a un
# archivo y falla; solo se define si de verdad hay un JSON de cuenta de servicio.
# GOOGLE_APPLICATION_CREDENTIALS=

# ── Autenticación de la app ───────────────────────────────────────────────────
# API FastAPI (sesión firmada con HMAC). La interfaz mínima actual NO tiene pantalla de
# login: para probarla, AUTH_ENABLED=false. Con true la API responde 401 y la UI avisa.
AUTH_ENABLED=false
AUTH_USERNAME=
AUTH_PASSWORD=
# Solo la API: firma de sesión estable entre reinicios y workers. Sin ella se genera una
# por proceso y las sesiones no sobreviven a un reinicio. Mínimo 32 caracteres.
AUTH_SECRET_KEY=
# AUTH_SESSION_TTL=
# AUTH_COOKIE_SECURE=

# ── Marca ─────────────────────────────────────────────────────────────────────
# Rutas a los logotipos reales. Los archivos viven en assets/brand/, fuera de git;
# sin ellos la app cae a los placeholders versionados de assets/brand/_placeholder/.
BRAND_LOGO_BANNER=
BRAND_LOGO_MARK=
BRAND_LOGO_MEMBRETE=

# ── Fase 3 · Managed Identity (Azure) ─────────────────────────────────────────
# Todavía NO implementado (ver PLAN_MEJORAS_ANEXO.md §10). Con clave, hoy se usa el
# backend Foundry de arriba (FOUNDRY_AI_*). Esto documenta la forma que tendrá la
# configuración cuando la autenticación pase a Managed Identity (DefaultAzureCredential):
# el mismo cliente Azure, sin `FOUNDRY_AI_TOKEN`, sin credenciales que filtrar.
